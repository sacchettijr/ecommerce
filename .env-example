# =========================================================
# GENERAL
# =========================================================

DEBUG=
SECRET_KEY=
LANGUAGE_CODE=
TIME_ZONE=
USER_TEST_PASSWORD=


# =========================================================
# DJANGO / BACKEND
# =========================================================

ALLOWED_HOSTS=
#   Optional. Extra trusted CSRF origins (with scheme), besides what Render adds by
#   itself via RENDER_EXTERNAL_HOSTNAME. E.g.: https://mydomain.com
CSRF_TRUSTED_ORIGINS=
PAGE_SIZE=
PHONENUMBER_DEFAULT_REGION=


# =========================================================
# FRONTEND
# =========================================================

#   FRONTEND_URL: where a person actually reaches the React app right now — used for
#   email links (signup confirmation, password reset), product/category links, and CORS.
#   Behind Nginx: "http://localhost" (port 80). Testing without Nginx, direct ports open:
#   "http://localhost:5173" (the Vite port). In production: the real domain, HTTPS.
FRONTEND_URL=http://localhost
#   VITE_API_URL: where the React app finds the Django API. Behind Nginx (same origin),
#   the relative "/api" is enough. Without Nginx, it needs the Django port, e.g.
#   "http://localhost:8000/api".
VITE_API_URL=/api


# =========================================================
# DATABASE (local Docker Postgres)
# =========================================================

#   DATABASE_URL (Render's managed Postgres) belongs ONLY in Render's own dashboard for
#   the Render service — never here, not even commented out. Leaving it unset here makes
#   Django fall back to the discrete POSTGRES_* variables below (Docker Compose database).
POSTGRES_ENGINE=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=


# =========================================================
# REDIS (Django cache + Celery result backend)
# =========================================================

REDIS_HOST=
REDIS_PORT=
REDIS_CELERY_DB=
REDIS_CACHE_DB=


# =========================================================
# CELERY / RABBITMQ (message broker)
# =========================================================

RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_DEFAULT_VHOST=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=


# =========================================================
# EMAIL
# =========================================================

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=


# =========================================================
# SUPERUSER (manage.py create_admin)
# =========================================================

DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_DATE_BIRTH=


# =========================================================
# RENDER / PRODUCTION (set only in Render's dashboard, never here)
# =========================================================

#   DATABASE_URL, RENDER and RENDER_EXTERNAL_HOSTNAME are provided by Render itself —
#   nothing to configure locally for them.
